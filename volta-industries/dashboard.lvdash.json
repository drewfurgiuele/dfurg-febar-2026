{
  "datasets": [
    {
      "name": "ds_exposure",
      "displayName": "Exposure (metric view)",
      "queryLines": [
        "SELECT plant_id, machine_type, risk_band, criticality, ",
        "MEASURE(downtime_exposure) AS downtime_exposure_usd, ",
        "MEASURE(open_work_orders) AS open_work_orders, ",
        "MEASURE(critical_count) AS critical_count, ",
        "MEASURE(atrisk_count) AS atrisk_count, ",
        "MEASURE(line_count) AS line_count ",
        "FROM dfurg_febar_catalog.volta_industrial.mv_line_risk GROUP BY ALL"
      ]
    },
    {
      "name": "ds_scatter",
      "displayName": "Lines (sampled for scatter)",
      "queryLines": [
        "SELECT line_id, plant_id, machine_type, criticality, plant_lat, plant_lng, ",
        "risk_band, failure_risk_score, vibration_rms, temperature_c, open_wo_count, downtime_exposure_usd ",
        "FROM dfurg_febar_catalog.volta_industrial.gold_line_status WHERE risk_band <> 'healthy' OR rand() < 0.1"
      ]
    },
    {
      "name": "ds_worst",
      "displayName": "Highest exposure lines",
      "queryLines": [
        "SELECT line_id, plant_id, machine_type, risk_band, vibration_rms, failure_risk_score, open_wo_count, downtime_exposure_usd ",
        "FROM dfurg_febar_catalog.volta_industrial.gold_line_status WHERE risk_band IN ('critical','elevated') ORDER BY downtime_exposure_usd DESC"
      ]
    },
    {
      "name": "ds_watch",
      "displayName": "Rising-risk watch list",
      "queryLines": [
        "SELECT line_id, plant_id, machine_type, risk_band, failure_risk_score, open_wo_count ",
        "FROM dfurg_febar_catalog.volta_industrial.gold_line_status WHERE risk_band = 'watch' ORDER BY failure_risk_score DESC"
      ]
    },
    {
      "name": "ds_maintenance",
      "displayName": "Maintenance recommendations",
      "queryLines": [
        "SELECT line_id, recommended_action, predicted_downtime_cost_avoided_usd, predicted_net_value_usd ",
        "FROM dfurg_febar_catalog.volta_industrial.gold_maintenance_recommendations"
      ]
    }
  ],

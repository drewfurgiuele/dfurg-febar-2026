{
  "name": "volta-plant-floor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env server/server.ts",
    "build": "npm run build:client && npm run build:source",
    "build:client": "vite build --config client/vite.config.ts",
    "build:source": "tsdown --config tsdown.server.config.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@databricks/appkit": "latest",
    "@openai/agents": "latest",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mlflow-tracing": "latest",
    "openai": "^7.0.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.0.1",
    "react-router": "^7.1.1",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@databricks/appkit-ui": "latest",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsdown": "latest",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
